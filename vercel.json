{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/refresh",
      "schedule": "0 10 * * *"
    }
  ],
  "functions": {
    "api/cron/refresh.ts": {
      "maxDuration": 300
    }
  }
}
